rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function role(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
  function admin(){ return signedIn() && role() == "admin"; }
  function driver(){ return signedIn() && role() in ["driver","admin"]; }
  match /users/{uid} {
   allow read: if signedIn() && (request.auth.uid == uid || admin());
   allow write: if admin();
  }
  match /Students/{studentId} {
   allow read: if driver();
   allow write: if admin();
  }
  match /attendance/{id} {
   allow create: if driver() && request.resource.data.driverUid == request.auth.uid;
   allow read: if admin() || (driver() && resource.data.driverUid == request.auth.uid);
   allow update, delete: if admin();
  }
  match /pickup_records/{id} {
   allow create: if driver() && request.resource.data.driverUid == request.auth.uid;
   allow read: if admin() || (driver() && resource.data.driverUid == request.auth.uid);
   allow update, delete: if admin();
  }
  match /movement_history/{id} {
   allow create: if driver() && request.resource.data.driverUid == request.auth.uid;
   allow read: if admin() || (driver() && resource.data.driverUid == request.auth.uid);
   allow update, delete: if admin();
  }
 }
}